o<m6_remap> sub

    o<skip> if [#<_selected_tool> EQ #<_current_tool>]
        o<m6_remap> return
    o<skip> endif

    M5  (stop the spindle)
    M6  (move to TOOL_CHANGE_POSITION, then changes the tool)
    G43 (apply tool length offset)
    M0  (confirm the tool change with a cycle start)

o<m6_remap> endsub
