O<knurling> sub

#<x_start>            = #1
#<z_start>            = #2
#<z_end>              = #3
#<doc>                = #4
#<retract>            = #5
#<grooves_count>      = #6
#<inspect_position>   = #7
#<include_m1>         = #8
#<spindle_dir>        = #9

G7  ; Lathe Diameter Mode
G18 ; XZ Plane
G21 ; Metric Units
G90 ; Absolute Distance

#<grooves_count> = [FIX[ABS[#<grooves_count>]]]
o10 if [#<grooves_count> LT 1]
    #<grooves_count> = 1
o10 endif

#<x_drive> = [#<x_start> - [2 * #<doc>]]
#<x_clear> = [#<x_start> + #<retract>]
#<lead> = [3.141592653589793 * #<x_start>]
#<angle_step> = [360.0 / #<grooves_count>]

G0 X#<x_clear> Z#<z_start>

#<pass_index> = 0
o100 while [#<pass_index> LT #<grooves_count>]
    #<angle_offset> = [#<pass_index> * #<angle_step>]

    G0 X#<x_clear> Z#<z_start>
    G0 X#<x_drive>
    G33 Z#<z_end> K#<lead> D#<angle_offset>
    G0 X#<x_clear>

    o110 if [#<include_m1> NE 0]
        o<m1_handling> call [#<inspect_position>] [#<x_clear>] [#<z_end>] [#<spindle_dir>]
    o110 endif

    #<pass_index> = [#<pass_index> + 1]
o100 endwhile

#<pass_index> = 0
o200 while [#<pass_index> LT #<grooves_count>]
    #<angle_offset> = [#<pass_index> * #<angle_step>]

    G0 X#<x_clear> Z#<z_end>
    G0 X#<x_drive>
    G33 Z#<z_start> K#<lead> D#<angle_offset>
    G0 X#<x_clear>

    o210 if [#<include_m1> NE 0]
        o<m1_handling> call [#<inspect_position>] [#<x_clear>] [#<z_start>] [#<spindle_dir>]
    o210 endif

    #<pass_index> = [#<pass_index> + 1]
o200 endwhile

G0 X#<x_clear> Z#<z_start>

O<knurling> endsub
