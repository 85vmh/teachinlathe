O<drilling> sub

#<x_start>      = #1
#<z_start>      = #2
#<z_end>        = #3
#<retract>      = #4
#<increment>    = #5
#<rpm>          = #6
#<feed>         = #7

(--- setup ---)
G7   (Diameter mode)
G21  (Metric)
G90  (Absolute)
G97 M4 S#<rpm>

#<x_start> = [#<x_start> / 2]  (half diameter -> radius)

G0 X0
G95
F#<feed>

(--- manual peck drilling variables ---)
#<current_z> = #<z_start>
#<step>      = [ABS[#<increment>]]

O101 if [#<z_end> LT #<z_start>]
  #<step> = [-#<step>]        (drill toward negative Z)
O101 endif

(Go to retract plane before first peck)
G0 Z#<retract>

(--- peck loop ---)
O100 while [ ( [#<step> LT 0] AND [#<current_z> GT #<z_end>] ) OR ( [#<step> GT 0] AND [#<current_z> LT #<z_end>] ) ]

  (# target for this peck, clamp to z_end)
  #<target_z> = [#<current_z> + #<step>]

  O102 if [[#<step> LT 0] AND [#<target_z> LT #<z_end>]]
    #<target_z> = #<z_end>
  O102 endif

  O103 if [[#<step> GT 0] AND [#<target_z> GT #<z_end>]]
    #<target_z> = #<z_end>
  O103 endif

  (feed down to target)
  G1 Z#<target_z> F#<feed>

  (retract to plane)
  G0 Z#<retract>

  (optional stop before the next peck, but not after the last)
  O104 if [#<target_z> NE #<z_end>]
    M1
  O104 endif

  (# advance)
  #<current_z> = #<target_z>

O100 endwhile

(--- restore positions similar to original ---)
G0 Z#<z_start>
G0 X#<x_start>

G18  (back to XZ plane)
M5
O<drilling> endsub
