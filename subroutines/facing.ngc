O<facing> sub

#<x_start>  	= #1
#<z_start>  	= #2
#<x_end>    	= #3
#<z_end>    	= #4
#<x_inspect>    = #5
#<z_inspect>    = #6
#<doc>      	= #7
#<spindle_dir>  = #8


G7 	; Lathe Diameter Mode
G18 ; XZ Plane
G21 ; Metric Units
G90 ; Absolute Distance

G0 X#<x_start> Z#<z_start>

O200 WHILE [#<z_start> GT #<z_end> + #<doc>]

	#<z_start> = [#<z_start> - #<doc>]

	G1 Z#<z_start>
	G1 X#<x_end>
	G0 Z[#<z_start> + #<doc>]
	G0 X#<x_start>
	G0 Z#<z_start>

	o<m1_handling> call [#<x_inspect>] [#<z_inspect>] [#<x_start>] [#<z_start>] [#<spindle_dir>]

O200 ENDWHILE

G1 Z#<z_end>
G1 X#<x_end>
G0 Z[#<z_start> + #<doc>]
G0 X[#<x_start> + #<doc>]
G0 Z#<z_end> ; For touch-off

O<facing> endsub
